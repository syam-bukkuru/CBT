{
  "name": "cbt",
  "private": true,
  "version": "0.0.0",
  "description": "Modular mock-test practice portal",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,green \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "start": "npm run start -w backend",
    "build": "npm run build -w frontend",
    "lint": "npm run lint -w frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
